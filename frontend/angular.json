{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "panda-catalogo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.json",
            "styles": ["src/styles.css"],
            "baseHref": "/gestion-catalogo/"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {"scripts": true, "styles": true, "fonts": false},
              "budgets": [
                {"type": "initial", "maximumWarning": "450kB", "maximumError": "700kB"}
              ]
            },
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"buildTarget": "panda-catalogo:build:development", "servePath": "/gestion-catalogo/"}
        }
      }
    }
  }
}
